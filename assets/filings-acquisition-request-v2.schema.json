{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/filings-acquisition-request-v2.schema.json",
  "title": "Declarative filing acquisition request with explicit source-mode ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "company",
    "sources",
    "filing_facts",
    "source_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "filings-acquisition-request/2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "$ref": "#/$defs/entityIdentifiers"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consolidation_level": {
          "enum": [
            "group",
            "issuer",
            "opco",
            "unknown"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "filing_facts": {
      "$ref": "filings-extraction-request-v1.schema.json#/$defs/filingFacts"
    },
    "source_mode": {
      "enum": [
        "internal",
        "user_supplied",
        "internal_fallback"
      ]
    },
    "fallback_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "entityIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lei": {
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "cusip": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "factset_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_number": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "attachment_id",
        "source_id",
        "origin",
        "media_type",
        "filing_kind",
        "filing_date",
        "covered_periods",
        "section_coverage",
        "restatement_basis"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "origin": {
          "enum": [
            "user_supplied",
            "official_declarative_url",
            "runtime_library"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "publisher_name": {
          "type": "string",
          "minLength": 1
        },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "uniqueItems": true
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "filing_kind": {
          "enum": [
            "annual_report",
            "annual_results",
            "restatement",
            "interim_report",
            "debt_note",
            "supplemental"
          ]
        },
        "filing_date": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "covered_periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "date"
          },
          "uniqueItems": true
        },
        "section_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "income_statement",
              "cash_flow",
              "debt_notes",
              "issuer_facts"
            ]
          },
          "uniqueItems": true
        },
        "restatement_basis": {
          "enum": [
            "as_reported",
            "restated_comparative"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "official_declarative_url"
              }
            }
          },
          "then": {
            "required": [
              "url",
              "publisher_name",
              "allowed_domains"
            ],
            "not": {
              "required": [
                "path"
              ]
            }
          },
          "else": {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_mode": {
            "const": "internal_fallback"
          }
        }
      },
      "then": {
        "required": [
          "fallback_reason"
        ]
      }
    }
  ]
}
