{
  "schema_version": "broker-state-machine/2.0",
  "initial_state": "INGESTED",
  "states": [
    "INGESTED",
    "NATIVE_INSPECTED",
    "NATIVE_EVALUATED",
    "NATIVE_SELECTED",
    "RECOVERY_HOUSE_SELECTED",
    "RECOVERY_REQUESTED",
    "RECOVERY_RESPONSE_RECEIVED",
    "RECOVERY_VERIFIED",
    "RECOVERED_HOUSE_SELECTED",
    "ZERO_AUTHORITY_CLOSED"
  ],
  "terminal_states": ["NATIVE_SELECTED", "RECOVERED_HOUSE_SELECTED", "ZERO_AUTHORITY_CLOSED"],
  "transitions": [
    ["INGESTED", "NATIVE_INSPECTED"],
    ["NATIVE_INSPECTED", "NATIVE_EVALUATED"],
    ["NATIVE_EVALUATED", "NATIVE_SELECTED"],
    ["NATIVE_EVALUATED", "RECOVERY_HOUSE_SELECTED"],
    ["NATIVE_EVALUATED", "ZERO_AUTHORITY_CLOSED"],
    ["RECOVERY_HOUSE_SELECTED", "RECOVERY_REQUESTED"],
    ["RECOVERY_REQUESTED", "RECOVERY_RESPONSE_RECEIVED"],
    ["RECOVERY_REQUESTED", "ZERO_AUTHORITY_CLOSED"],
    ["RECOVERY_RESPONSE_RECEIVED", "RECOVERY_VERIFIED"],
    ["RECOVERY_RESPONSE_RECEIVED", "ZERO_AUTHORITY_CLOSED"],
    ["RECOVERY_VERIFIED", "RECOVERED_HOUSE_SELECTED"],
    ["RECOVERY_VERIFIED", "ZERO_AUTHORITY_CLOSED"]
  ],
  "maximum_recovery_house_count": 1,
  "authority_rule": "one_coherent_house_or_zero_authority"
}
