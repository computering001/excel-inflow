{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/disk-space-sample-receipt-manifest-v1.schema.json",
  "title": "Excel Inflow disk-space portable resource-sample manifest 1.2",
  "description": "Hash custody for portable projections of original external resource-sample.json receipts. Each projection retains the original receipt SHA-256, exact input hashes and raw observation series while refusing host-specific paths and local metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "corpora", "samples"],
  "properties": {
    "schema_version": { "const": "excel-inflow-disk-space-sample-receipt-manifest/1.2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "corpora": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filings", "brokers", "workbook"],
      "properties": {
        "filings": { "$ref": "#/$defs/corpusPointer" },
        "brokers": { "$ref": "#/$defs/corpusPointer" },
        "workbook": { "$ref": "#/$defs/corpusPointer" }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 60,
      "items": { "$ref": "#/$defs/samplePointer" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\](?:.*[^/\\\\])?$" },
    "corpusPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": { "$ref": "#/$defs/safeRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "excel-inflow-disk-space-corpus-manifest/1.1" }
      }
    },
    "samplePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "cohort_id", "resource_cohort_id", "resource_sample_id",
        "path", "sha256", "resource_sample_schema_version",
        "source_resource_sample_schema_version", "source_receipt_sha256"
      ],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "cohort_id": { "enum": ["filings", "brokers", "workbook"] },
        "resource_cohort_id": {
          "enum": ["real-astra-filings", "broker-82-pages", "standard-maximal-workbook"]
        },
        "resource_sample_id": { "type": "string", "pattern": "^sample-[0-9]{2}$" },
        "path": { "$ref": "#/$defs/safeRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "resource_sample_schema_version": { "const": "excel-inflow-component-resource-sample-portable/1.0" },
        "source_resource_sample_schema_version": { "const": "excel-inflow-component-resource-sample/1.0" },
        "source_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
