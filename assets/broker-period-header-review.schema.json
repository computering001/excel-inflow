{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-period-header-review.schema.json",
  "title": "Rendered broker period-header adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "bundle_sha256", "canonical_tables_sha256",
    "candidate_manifest_sha256", "producer_id", "producer_fingerprint",
    "reviewed_at", "decisions"
  ],
  "properties": {
    "schema_version": {"const": "broker-period-header-review/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_tables_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer_id": {"type": "string", "minLength": 1},
    "producer_fingerprint": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": ["string", "null"]},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "surface_id", "table_id", "headers", "rationale"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "surface_id": {"type": "string", "minLength": 1},
          "table_id": {"type": "string", "minLength": 1},
          "headers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "period_label"],
              "properties": {
                "column": {"type": "integer", "minimum": 1},
                "period_label": {"type": "string", "minLength": 2}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 12}
        }
      }
    }
  }
}
