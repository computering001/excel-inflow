{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-table-engine-result.schema.json",
  "title": "Provider-neutral broker table-engine output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider", "document_id", "surface_id", "image_sha256",
    "execution_fingerprint", "tables"
  ],
  "properties": {
    "schema_version": {"const": "broker-table-engine-result/1.0"},
    "provider": {"enum": ["rogo_vision", "surya_layout", "docling"]},
    "document_id": {"type": "string", "minLength": 1},
    "surface_id": {"type": "string", "minLength": 1},
    "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_fingerprint": {"type": "string", "minLength": 1},
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "units", "rows"],
        "properties": {
          "title": {"type": ["string", "null"]},
          "units": {"type": ["string", "null"]},
          "bbox": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "cell_bboxes": {"type": ["array", "null"]},
          "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1}}
        }
      }
    },
    "footnotes": {"type": "array", "items": {"type": "string"}}
  }
}
