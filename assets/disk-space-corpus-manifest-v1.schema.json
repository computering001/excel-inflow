{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/disk-space-corpus-manifest-v1.schema.json",
  "title": "Excel Inflow disk-space corpus manifest 1.1",
  "description": "Typed custody for the exact representative source corpus exercised by one disk-space workload cohort.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "workload_kind", "resource_cohort_id", "generated_at", "sources"],
  "properties": {
    "schema_version": { "const": "excel-inflow-disk-space-corpus-manifest/1.1" },
    "corpus_id": { "type": "string", "minLength": 1 },
    "workload_kind": { "enum": ["filings", "brokers", "workbook"] },
    "resource_cohort_id": {
      "enum": ["real-astra-filings", "broker-82-pages", "standard-maximal-workbook"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "sha256", "bytes"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/safeRelativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\](?:.*[^/\\\\])?$" }
  }
}
