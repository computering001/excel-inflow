    "INTERNAL_WORK",
    "USER_EVIDENCE",
    "USER_DECISION",
    "FATAL_SOURCE"
  ],
  "user_blocking_classes": [
    "USER_EVIDENCE",
    "USER_DECISION",
    "FATAL_SOURCE"
  ],
  "delivery_blocker_constitution": {
