{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/dcs-crosswalk-v1.schema.json",
  "title": "Reviewed lossless DCS crosswalk",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_tables_sha256", "candidate_manifest_sha256", "export_metadata", "row_dispositions", "cell_dispositions", "instruments", "supplements"],
  "properties": {
    "schema_version": {"const": "dcs-crosswalk/1.0"},
    "source_tables_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "export_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "source", "entity", "reporting_currency", "units", "columns"],
      "properties": {
        "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["system", "date_basis"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "date_basis": {"enum": ["last_fiscal_year_end", "as_at_export_date", "other"]},
            "exported_at": {"type": ["string", "null"]},
            "report_name": {"type": ["string", "null"]}
          }
        },
        "entity": {
          "type": "object", "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "identifiers": {"type": "object"},
            "consolidation_level": {"enum": ["group", "issuer", "opco", "unknown"]}
          }
        },
        "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "units": {"enum": ["units", "thousands", "millions"]},
        "columns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["field", "currency", "units"],
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "units": {"enum": ["units", "thousands", "millions"]}
            }
          }
        }
      }
    },
    "row_dispositions": {"type": "array", "items": {"$ref": "#/$defs/rowDisposition"}},
    "cell_dispositions": {"type": "array", "items": {"$ref": "#/$defs/cellDisposition"}},
    "instruments": {"type": "array", "items": {"$ref": "#/$defs/instrument"}},
    "supplements": {"type": "array", "items": {"$ref": "#/$defs/supplement"}}
  },
  "$defs": {
    "disposition": {"enum": ["model_input", "derived_model_input", "supplemental_evidence", "duplicate", "not_applicable", "unresolved"]},
    "rowDisposition": {"type": "object", "additionalProperties": false, "required": ["row_id", "disposition", "rationale"], "properties": {"row_id": {"type": "string"}, "disposition": {"$ref": "#/$defs/disposition"}, "rationale": {"type": "string", "minLength": 1}, "owner_id": {"type": ["string", "null"]}, "duplicate_of": {"type": ["string", "null"]}}},
    "cellDisposition": {"type": "object", "additionalProperties": false, "required": ["cell_id", "disposition", "rationale"], "properties": {"cell_id": {"type": "string"}, "disposition": {"$ref": "#/$defs/disposition"}, "rationale": {"type": "string", "minLength": 1}, "owner_id": {"type": ["string", "null"]}, "duplicate_of": {"type": ["string", "null"]}}},
    "instrument": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "disposition", "rationale", "row_ids", "term_authorities"], "properties": {"candidate_id": {"type": "string"}, "instrument_id": {"type": ["string", "null"]}, "disposition": {"$ref": "#/$defs/disposition"}, "rationale": {"type": "string", "minLength": 1}, "row_ids": {"type": "array", "items": {"type": "string"}}, "term_authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}}, "duplicate_of": {"type": ["string", "null"]}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["model_field", "output_value", "source_cells", "transform", "authority_kind", "precision"], "properties": {"model_field": {"type": "string"}, "output_value": {}, "source_cells": {"type": "array", "items": {"type": "string"}}, "transform": {"type": "object"}, "authority_kind": {"enum": ["source_cell", "derived_source_cells", "supplement"]}, "precision": {"enum": ["exact", "month", "year", "bucket", "non_maturing"]}, "supplement_id": {"type": "string"}, "basis": {"type": "object"}}},
    "supplement": {"type": "object", "additionalProperties": false, "required": ["supplement_id", "instrument_id", "model_field", "value", "source_kind", "source_reference"], "properties": {"supplement_id": {"type": "string"}, "instrument_id": {"type": "string"}, "model_field": {"type": "string"}, "value": {}, "source_kind": {"enum": ["company_document", "user_answer"]}, "source_reference": {"type": "string", "minLength": 1}}}
  }
}
