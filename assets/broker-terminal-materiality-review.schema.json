{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-terminal-materiality-review.schema.json",
  "title": "Model-host review of terminal non-consumed broker candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "bundle_sha256", "candidate_manifest_sha256",
    "source_crosswalk_sha256", "semantic_report_sha256", "producer_id",
    "reviewed_at", "reviews"
  ],
  "properties": {
    "schema_version": { "const": "broker-terminal-materiality-review/1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_crosswalk_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semantic_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producer_id": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": ["string", "null"] },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "disposition", "model_consumption", "rationale"],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^bc-[a-f0-9]{24}$" },
          "disposition": { "const": "preserve_unconsumed_quarantine" },
          "model_consumption": { "const": "prohibited" },
          "rationale": { "type": "string", "minLength": 12 }
        }
      }
    }
  }
}
