{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-surface-census.schema.json",
  "title": "Independent whole-surface broker census",
  "type": "object",
  "required": ["schema_version", "document_id", "surface_id", "kind", "whole_surface_numeric_token_count", "table_discovery_lanes", "uncovered_numeric_regions", "material_uncovered_region_count"],
  "properties": {
    "schema_version": {"const": "broker-surface-census/1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "surface_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["pdf_page", "workbook_sheet", "image_page", "text_document"]},
    "whole_surface_numeric_token_count": {"type": ["integer", "null"], "minimum": 0},
    "source_numeric_tokens": {"type": "array"},
    "source_cells": {"type": "array"},
    "nonblank_cell_count": {"type": "integer", "minimum": 0},
    "table_discovery_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lane_id", "status", "candidate_count"],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "empty", "error", "unsupported"]},
          "candidate_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "uncovered_numeric_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region_id", "material", "disposition"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"},
          "disposition": {"type": "string", "minLength": 1},
          "bbox": {"type": ["array", "null"], "minItems": 4, "maxItems": 4},
          "token_ids": {"type": "array", "items": {"type": "string"}},
          "tokens": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "material_uncovered_region_count": {"type": "integer", "minimum": 0}
  }
}
