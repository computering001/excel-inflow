{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-run-state.schema.json",
  "title": "Resumable Excel Inflow broker evidence transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "pipeline_status",
    "user_blocking",
    "blocker_class",
    "request_sha256",
    "source_sha256",
    "runtime_closure_sha256",
    "cache_key",
    "checkpoints",
    "artifacts",
    "artifact_sha256",
    "tasks",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "broker-run-state/1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "pipeline_status": {
      "enum": [
        "NEEDS_VISION",
        "NEEDS_RESOLUTION",
        "NEEDS_CROSSWALK",
        "NEEDS_CROSSWALK_REVIEW",
        "PASS",
        "BLOCKED_INPUT",
        "BLOCKED_INTERNAL"
      ]
    },
    "user_blocking": { "type": "boolean" },
    "blocker_class": {
      "type": ["string", "null"],
      "enum": ["INTERNAL_WORK", "USER_EVIDENCE", "USER_DECISION", "FATAL_SOURCE", null]
    },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_sha256": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "runtime_closure_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cache_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "input_sha256", "output_sha256", "reused"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "NEEDS_WORK", "BLOCKED"] },
          "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "output_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "reused": { "type": "boolean" }
        }
      }
    },
    "artifacts": { "type": "object" },
    "artifact_sha256": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "tasks": { "type": "array", "items": { "type": "object" } },
    "attempts": {
      "type": "object",
      "properties": {
        "vision_response_sha256": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "uniqueItems": true
        },
        "vision_attempt_count": { "type": "integer", "minimum": 0 },
        "vision_attempt_limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "summary": { "type": "object" }
  }
}
