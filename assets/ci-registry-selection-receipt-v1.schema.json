{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/ci-registry-selection-receipt-v1.schema.json",
  "title": "Externally retained CI registry selection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "source_binding", "registry_sha256", "counts",
    "selected_test_ids", "selected_test_ids_sha256",
    "installed_host_excluded_test_ids", "rows", "recorded_at", "evidence_sha256"
  ],
  "properties": {
    "schema_version": { "const": "excel-inflow-ci-registry-selection-receipt/1.0" },
    "status": { "const": "PASS" },
    "source_binding": { "$ref": "#/$defs/source_binding" },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "portable", "installed_host_excluded", "selected"],
      "properties": {
        "registry": { "type": "integer", "minimum": 1 },
        "portable": { "type": "integer", "minimum": 1 },
        "installed_host_excluded": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 1 }
      }
    },
    "selected_test_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "selected_test_ids_sha256": { "$ref": "#/$defs/sha256" },
    "installed_host_excluded_test_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "timeout_seconds", "disposition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "command": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "disposition": { "enum": ["PORTABLE_SELECTED", "INSTALLED_HOST_EXCLUDED"] }
        }
      }
    },
    "recorded_at": { "type": "string", "minLength": 20 },
    "evidence_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_sha", "source_tree", "ref", "event_name", "run_id", "run_attempt"],
      "properties": {
        "github_sha": { "$ref": "#/$defs/sha1" },
        "source_tree": { "$ref": "#/$defs/sha1" },
        "ref": { "type": "string", "minLength": 1 },
        "event_name": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "run_attempt": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
