{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/forecast-authority-ledger-v2.schema.json",
  "title": "Excel Inflow sealed forecast authority ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "forecast_periods",
    "status",
    "rows",
    "selected_metric_traces",
    "violations",
    "ledger_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "forecast-authority-ledger/2.0"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "forecast_periods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCK"
      ]
    },
    "rows": {
      "type": "array"
    },
    "selected_metric_traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["demand_concept", "source_page_cell", "house", "period", "units", "definition", "compatibility_score", "selection_score", "rejection_reasons", "selected_value", "workbook_destination", "final_formula", "method"],
        "properties": {
          "demand_concept": {"type": "string", "minLength": 1},
          "source_page_cell": {"type": ["string", "null"]},
          "house": {"type": ["string", "null"]},
          "period": {"type": "string", "format": "date"},
          "units": {"type": ["string", "null"]},
          "definition": {"type": ["string", "null"]},
          "compatibility_score": {"type": "number"},
          "selection_score": {"type": "number"},
          "rejection_reasons": {"type": "array", "items": {"type": "string"}},
          "selected_value": {"type": ["number", "string", "null"]},
          "workbook_destination": {"type": "string", "minLength": 1},
          "final_formula": {"type": ["object", "string", "null"]},
          "method": {"type": ["string", "null"]}
        }
      }
    },
    "violations": {
      "type": "array"
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
