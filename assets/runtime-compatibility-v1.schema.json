{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/runtime-compatibility-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "range_semantics",
    "selection_contract",
    "rogo_host_validation",
    "runtimes"
  ],
  "properties": {
    "schema_version": { "const": "excel-inflow-runtime-compatibility/1.0" },
    "status": { "const": "LOCAL_AND_PORTABLE_CI_EXERCISED_ROGO_PENDING" },
    "range_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "unversioned_ci_policy", "range_expansion_policy"],
      "properties": {
        "minimum": { "const": "inclusive" },
        "maximum": { "const": "exclusive" },
        "unversioned_ci_policy": { "type": "string", "minLength": 1 },
        "range_expansion_policy": { "type": "string", "minLength": 1 }
      }
    },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_interpreter_count", "distribution_query", "mapping_rule"],
      "properties": {
        "python_interpreter_count": { "const": 1 },
        "distribution_query": { "const": "importlib.metadata through the selected interpreter" },
        "mapping_rule": { "type": "string", "minLength": 1 }
      }
    },
    "rogo_host_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "promotion_blocking", "reason", "required_capture"],
      "properties": {
        "status": { "const": "PENDING" },
        "promotion_blocking": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "required_capture": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/runtime" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_name",
        "runtime_kind",
        "import_name",
        "distribution_name",
        "minimum_version",
        "maximum_exclusive_version",
        "version_parser",
        "required_by_lanes",
        "reason",
        "version_source",
        "api_evidence",
        "exercise_evidence"
      ],
      "properties": {
        "runtime_name": { "type": "string", "minLength": 1 },
        "runtime_kind": {
          "enum": ["node_runtime", "python_runtime", "python_distribution", "external_binary"]
        },
        "import_name": { "type": ["string", "null"] },
        "distribution_name": { "type": "string", "minLength": 1 },
        "minimum_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "maximum_exclusive_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "version_parser": {
          "enum": ["node_semver", "python_tuple", "python_distribution", "libreoffice_banner"]
        },
        "required_by_lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["always", "evidence", "broker", "workbook"] }
        },
        "reason": { "type": "string", "minLength": 1 },
        "version_source": { "type": "string", "minLength": 1 },
        "api_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exercise_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "status", "observed_version", "precision", "evidence_pointer"],
      "properties": {
        "environment": { "enum": ["authoring_host", "portable_ci", "rogo_installed_host"] },
        "status": { "enum": ["EXERCISED", "EXERCISED_UNVERSIONED", "PENDING"] },
        "observed_version": { "type": ["string", "null"] },
        "precision": { "enum": ["exact", "major", "major_minor", "unversioned", "unknown"] },
        "evidence_pointer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
