{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-extraction-bundle.schema.json",
  "title": "Excel Inflow lossless broker-document evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "extractor_version",
    "documents",
    "summary",
    "gate_status"
  ],
  "properties": {
    "schema_version": { "const": "broker-extraction-bundle/1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "created_at": { "type": "string", "minLength": 10 },
    "extractor_version": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "tool_versions": { "type": "object" },
    "canonical_tables_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_manifest": { "type": "object" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/document" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_count",
        "surface_count",
        "table_count",
        "cell_count",
        "numeric_token_count",
        "native_numeric_recall",
        "unresolved_surface_count",
        "duplicate_cell_count"
      ],
      "properties": {
        "document_count": { "type": "integer", "minimum": 1 },
        "surface_count": { "type": "integer", "minimum": 1 },
        "table_count": { "type": "integer", "minimum": 0 },
        "cell_count": { "type": "integer", "minimum": 0 },
        "numeric_token_count": { "type": "integer", "minimum": 0 },
        "native_numeric_recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "unresolved_surface_count": { "type": "integer", "minimum": 0 },
        "duplicate_cell_count": { "type": "integer", "minimum": 0 },
        "uncovered_numeric_region_count": { "type": "integer", "minimum": 0 },
        "material_uncovered_region_count": { "type": "integer", "minimum": 0 }
      }
    },
    "gate_status": { "enum": ["PASS", "NEEDS_VISION", "BLOCKED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "blocker"] },
          "document_id": { "type": ["string", "null"] },
          "surface_id": { "type": ["string", "null"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "house_id",
        "house_name",
        "source_id",
        "file_name",
        "media_type",
        "published_date",
        "raw_sha256",
        "byte_length",
        "surfaces",
        "tables",
        "numeric_ledger",
        "artifacts",
        "extraction_status"
      ],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "house_id": { "type": "string", "minLength": 1 },
        "house_name": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "file_name": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "published_date": { "type": "string", "format": "date" },
        "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/table" }
        },
        "canonical_tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/table" }
        },
        "numeric_ledger": { "$ref": "#/$defs/numericLedger" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "extraction_status": { "enum": ["complete", "needs_vision", "blocked"] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "kind",
        "ordinal",
        "width",
        "height",
        "native_text_chars",
        "native_word_count",
        "numeric_token_count",
        "table_count",
        "image_count",
        "artifact_refs",
        "lane_status"
      ],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["pdf_page", "workbook_sheet", "text_document", "image_page"] },
        "ordinal": { "type": "integer", "minimum": 1 },
        "label": { "type": ["string", "null"] },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "native_text_chars": { "type": "integer", "minimum": 0 },
        "native_word_count": { "type": "integer", "minimum": 0 },
        "numeric_token_count": { "type": "integer", "minimum": 0 },
        "table_count": { "type": "integer", "minimum": 0 },
        "image_count": { "type": "integer", "minimum": 0 },
        "artifact_refs": { "type": "array", "items": { "type": "string" } },
        "lane_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native_text", "geometry", "tables", "images", "vision"],
          "properties": {
            "native_text": { "enum": ["pass", "empty", "unsupported", "error"] },
            "geometry": { "enum": ["pass", "empty", "unsupported", "error"] },
            "tables": { "enum": ["pass", "none", "unsupported", "error"] },
            "images": { "enum": ["pass", "none", "unsupported", "error"] },
            "vision": { "enum": ["not_required", "required", "complete", "error"] }
          }
        },
        "vision_reason": { "type": ["string", "null"] },
        "whole_surface_numeric_token_count": { "type": ["integer", "null"], "minimum": 0 },
        "source_table_numeric_tokens": { "type": "array", "items": { "type": "string" } },
        "surface_census_artifact_id": { "type": "string", "minLength": 1 },
        "table_discovery_lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane_id", "status", "candidate_count"],
            "properties": {
              "lane_id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "empty", "error", "unsupported"] },
              "candidate_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "uncovered_numeric_regions": { "type": "array", "items": { "type": "object" } },
        "vision_source_census": { "type": "object" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "surface_id",
        "source_location",
        "extraction_method",
        "confidence",
        "rows"
      ],
      "properties": {
        "table_id": { "type": "string", "minLength": 1 },
        "surface_id": { "type": "string", "minLength": 1 },
        "source_location": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "units": { "type": ["string", "null"] },
        "bbox": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "extraction_method": {
          "enum": [
            "native_pdf_table",
            "native_pdf_text",
            "geometry_grid",
            "xlsx_cells",
            "csv",
            "json",
            "vision_pass_consensus",
            "manual_verified"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "canonical_table_id": { "type": "string", "minLength": 1 },
        "source_table_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extraction_methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "discovery_lane": { "type": ["string", "null"] },
        "footnotes": { "type": "array", "items": { "type": "string" } },
        "continuation_of": { "type": ["string", "null"] },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/cell" }
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "raw_text", "value", "value_kind", "source_ref"],
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "raw_text": { "type": ["string", "null"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "value_kind": { "enum": ["blank", "text", "number", "date", "boolean", "formula"] },
        "number_format": { "type": ["string", "null"] },
        "formula": { "type": ["string", "null"] },
        "bbox": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "address": { "type": ["string", "null"] },
        "bold": { "type": ["boolean", "null"] },
        "indent": { "type": ["integer", "number", "null"], "minimum": 0 }
      }
    },
    "numericLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_tokens", "captured_tokens", "missing_tokens", "duplicate_tokens", "recall"],
      "properties": {
        "source_tokens": { "type": "array", "items": { "type": "string" } },
        "captured_tokens": { "type": "array", "items": { "type": "string" } },
        "missing_tokens": { "type": "array", "items": { "type": "string" } },
        "duplicate_tokens": { "type": "array", "items": { "type": "string" } },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "denominator_scope": { "type": "string", "minLength": 1 },
        "captured_scope": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["native_text", "word_geometry", "page_image", "embedded_image", "table_json", "xlsx_grid", "vision_task", "surface_census"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
