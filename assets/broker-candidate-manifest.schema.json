{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-candidate-manifest.schema.json",
  "title": "Immutable broker candidate universe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "run_id", "source_bundle_sha256", "canonical_tables_sha256", "candidates", "findings", "gate_status", "summary", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "broker-candidate-manifest/1.0"},
    "manifest_version": {"const": "broker-candidate-manifest/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_tables_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "document_id", "house_id", "table_id", "row", "label", "row_kind", "parent_candidate_id", "period_basis", "period_indexes", "source_cells", "numeric", "numeric_cell_count", "header_context", "units", "definition_hints", "authority_status", "conflict_ids"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^bc-[a-f0-9]{24}$"},
          "document_id": {"type": "string", "minLength": 1},
          "house_id": {"type": "string", "minLength": 1},
          "table_id": {"type": "string", "minLength": 1},
          "row": {"type": "integer", "minimum": 1},
          "label": {"type": "string"},
          "row_kind": {"enum": ["header", "detail", "subtotal", "ratio", "blank"]},
          "parent_candidate_id": {"type": ["string", "null"]},
          "period_basis": {"enum": ["annual_forecast", "partial_period", "non_periodic", "unresolved_period_header"]},
          "period_indexes": {"type": "array"},
          "source_cells": {"type": "array", "minItems": 1},
          "numeric": {"type": "boolean"},
          "numeric_cell_count": {"type": "integer", "minimum": 0},
          "header_context": {"type": "array", "items": {"type": "string"}},
          "units": {"type": ["string", "null"]},
          "definition_hints": {"type": "array"},
          "authority_status": {"enum": ["verified", "quarantined_conflict"]},
          "conflict_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^bvc-[a-f0-9]{24}$"}}
        }
      }
    },
    "findings": {"type": "array"},
    "gate_status": {"enum": ["PASS", "BLOCKED"]},
    "summary": {"type": "object"}
  }
}
