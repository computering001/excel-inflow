{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/public-test-run-v1.schema.json",
  "title": "Debt Overlay autonomous public-company test envelope",
  "description": "A deliberately non-production evidence boundary for testing a real public issuer with public company documents and explicitly synthetic broker forecasts. It can exercise the model but can never satisfy the production evidence-run/1.0 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "promotion_status",
    "run_id",
    "created_at",
    "company_name",
    "source_inventory",
    "filings",
    "public_debt_schedule",
    "synthetic_broker_pack",
    "model_case",
    "restatement_decisions"
  ],
  "properties": {
    "schema_version": { "const": "public-test-run/1.0" },
    "purpose": { "const": "autonomous_public_company_test" },
    "promotion_status": { "const": "TEST_ONLY_NOT_PRODUCTION_EVIDENCE" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "created_at": { "type": "string", "minLength": 10 },
    "company_name": { "type": "string", "minLength": 1 },
    "source_inventory": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "filings": { "$ref": "#/$defs/filings" },
    "public_debt_schedule": { "$ref": "#/$defs/debtSchedule" },
    "synthetic_broker_pack": { "type": "object" },
    "model_case": { "type": "object" },
    "restatement_decisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/restatementDecision" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "name",
        "origin",
        "media_type",
        "entity_name",
        "content_sha256",
        "text_extractable",
        "status"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "kind": {
          "enum": [
            "company_annual_report",
            "company_interim_update",
            "company_debt_document",
            "company_transaction_announcement",
            "synthetic_broker_fixture"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["retrieved", "generated"] },
        "media_type": { "type": "string", "minLength": 1 },
        "publication_date": { "type": ["string", "null"] },
        "as_of_date": { "type": ["string", "null"] },
        "entity_name": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "text_extractable": { "type": "boolean" },
        "status": { "enum": ["used", "superseded", "rejected"] },
        "status_reason": { "type": "string" }
      }
    },
    "periods3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "format": "date" }
    },
    "filings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_name",
        "reporting_currency",
        "units",
        "historical_periods",
        "forecast_periods",
        "reported_gross_debt",
        "reported_cash"
      ],
      "properties": {
        "entity_name": { "type": "string", "minLength": 1 },
        "reporting_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "units": { "enum": ["units", "thousands", "millions"] },
        "historical_periods": { "$ref": "#/$defs/periods3" },
        "forecast_periods": { "$ref": "#/$defs/periods3" },
        "reported_gross_debt": { "type": "number", "minimum": 0 },
        "reported_cash": { "type": "number", "minimum": 0 }
      }
    },
    "debtSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "reporting_currency",
        "units",
        "reported_gross_debt",
        "instruments"
      ],
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "reporting_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "units": { "enum": ["units", "thousands", "millions"] },
        "reported_gross_debt": { "type": "number", "minimum": 0 },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/instrument" }
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "description",
        "instrument_type",
        "outstanding_amount",
        "currency",
        "rate_type",
        "source_ids"
      ],
      "properties": {
        "instrument_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "instrument_type": { "enum": ["fixed_bond", "floating_loan", "rcf", "commercial_paper", "securitisation", "other_debt"] },
        "outstanding_amount": { "type": "number", "minimum": 0 },
        "reporting_currency_carrying_amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maturity_date": { "type": ["string", "null"] },
        "rate_type": { "enum": ["fixed", "floating", "manual_all_in"] },
        "coupon_rate": { "type": ["number", "null"] },
        "reference_rate": { "type": ["string", "null"] },
        "margin_bps": { "type": ["number", "null"] },
        "all_in_rate": { "type": ["number", "null"] },
        "facility_limit": { "type": ["number", "null"], "minimum": 0 },
        "drawn_amount": { "type": ["number", "null"], "minimum": 0 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" }
        }
      }
    },
    "restatementDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "basis", "source_ids", "bridge_status", "reason"],
      "properties": {
        "period": { "type": "string", "format": "date" },
        "basis": { "enum": ["as_reported", "restated_comparative", "predecessor_combined", "calendarised"] },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "bridge_status": { "enum": ["not_required", "complete"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
