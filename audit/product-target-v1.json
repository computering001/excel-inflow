{
  "schema_version": "excel-inflow-product-target/1.0",
  "recorded_for_repair_branch": "agent/excel-inflow-end-to-end-repair",
  "baseline_source_commit": "ee5ae55cb8a0ce2f2d1d1b71810fc405c11416dd",
  "product_objective": "Deliver a company-specific, formula-driven corporate debt-overlay operating model that translates three historical years and three forecast years of operating outlook and cash generation into debt balances, interest, liquidity and leverage.",
  "visible_user_journey": [
    "company",
    "filings",
    "brokers",
    "debt",
    "build",
    "deliver"
  ],
  "required_workbook": {
    "principal_sheet": "Operating Model",
    "calculation_authority_sheets": [
      "Operating Model",
      "Brokers",
      "Forward Curves"
    ],
    "historical_year_count": 3,
    "forecast_year_count": 3,
    "main_sheet_geometry": {
      "standalone": "G:L",
      "acquisition_adjustments": "N:P",
      "pro_forma": "R:U"
    },
    "required_blocks": [
      "controls",
      "company_specific_income_statement",
      "adjusted_ebitda_bridge",
      "company_specific_cash_flow",
      "free_cash_flow_metrics",
      "instrument_level_debt_schedule",
      "cash_sweep_rcf_waterfall",
      "interest_schedule",
      "liquidity_and_leverage",
      "optional_funded_acquisition_case"
    ]
  },
  "mandatory_evidence": {
    "filings": "mandatory",
    "dcs_debt_export": "mandatory_for_live_debt_terms",
    "broker_research": "optional"
  },
  "delivery_invariant": "With valid mandatory filings and debt evidence, every broker state must still deliver a workbook. Optional broker failure removes only unverified authority and must not block the company model.",
  "usefulness_invariant": "When readable, definition-compatible and selected-cell-verifiable broker evidence can materially improve forecast authority, the delivered workbook must consume one coherent house rather than suppressing usable native evidence or defaulting vacuously to zero broker authority.",
  "statement_topology": {
    "source_visible_arithmetic_precedes_taxonomy": true,
    "relations_must_survive_relabelling": true,
    "three_period_value_reconciliation_required": true,
    "issuer_name_exceptions_forbidden": true,
    "example_required_relation": "Product Revenue = Product Sales + Alliance Revenue"
  },
  "broker_policy": {
    "archive_every_raw_document_and_page": true,
    "inspect_native_evidence_for_all_houses_before_recovery_selection": true,
    "authority_selection_basis": "material demanded coverage, semantic compatibility, selected-cell confidence and coherent-house completeness",
    "publication_date_role": "late_tie_break_only",
    "maximum_parallel_recovery_frontiers": 1,
    "cross_house_period_mixing": false,
    "selected_cell_provenance_required": true,
    "unverified_values_forbidden": true,
    "required_tier_1_demand": [
      "revenue",
      "ebit",
      "adjusted_ebitda",
      "depreciation_and_amortisation",
      "effective_tax_rate",
      "capex",
      "change_in_working_capital",
      "dividends",
      "share_buybacks"
    ],
    "headline_rule": "Exactly one of EBIT and Adjusted EBITDA may be the broker headline authority for a coherent house; D&A bridges to the other headline and the losing broker headline remains memo evidence only."
  },
  "forecast_policy": {
    "one_writer_per_row_period": true,
    "selected_authority_contract_is_sole_executable_forecast_writer": true,
    "discrete_event_history_inference_forbidden": [
      "historical_average",
      "historical_trend",
      "carry_forward"
    ],
    "discrete_event_forward_authorities": [
      "actual_plus_remainder",
      "contractual_commitment",
      "company_guidance",
      "company_indication",
      "verified_broker",
      "explicit_user_assumption",
      "supported_explicit_zero",
      "not_separately_forecast"
    ]
  },
  "funded_acquisition_case": {
    "single_supported_mode": "funded_transaction",
    "consideration_proxy": "transaction_enterprise_value",
    "consideration_cash_flow": "one investing outflow at close",
    "acquisition_debt_proceeds": "one financing inflow at close and persistent debt balance",
    "residual_funding": "existing cash then ordinary RCF mechanics",
    "automatic_equity_plug": false,
    "full_purchase_accounting": false,
    "synergies_fees_or_target_balance_sheet": false,
    "off_state_must_be_exactly_neutral": true
  },
  "protected_economic_invariants": [
    "declared_equation_graph",
    "cash_rcf_interest_fixed_point",
    "circularity_off_interest_zero_with_live_debt_and_cash_mechanics",
    "instrument_period_debt_state",
    "opening_debt_reconciliation",
    "debt_cash_rcf_lease_interest_liquidity_and_leverage_identities",
    "formula_cache_external_link_and_ooxml_integrity",
    "raw_attachment_hashes_and_content_addressed_resume"
  ],
  "runtime_policy": {
    "ask_only_for_material_unresolved_non_toggleable_facts": true,
    "internal_work_states_must_not_be_user_questions": true,
    "normal_three_broker_one_dcs_target_minutes": {
      "p50_max": 35,
      "p95_max": 45,
      "absolute_success_max": 50
    },
    "joined_trace_coverage_minimum": 0.98,
    "maximum_unowned_gap_seconds": 30
  },
  "release_policy": {
    "development_delivery_may_be_reviewed": true,
    "development_package_may_not_be_promoted_as_certified": true,
    "production_promotion_requires_same_source_tree_closure_across_all_evidence": true,
    "required_identity": [
      "repository",
      "source_commit",
      "git_tree",
      "closure_sha256",
      "package_mode",
      "certification_state",
      "installation_identity"
    ],
    "pass_pending_manual_is_not_release_pass": true
  },
  "forbidden_repairs": [
    "issuer_name_branches",
    "latest_date_as_quality",
    "ocr_every_page_of_every_report",
    "remove_broker_circuit_breaker",
    "consume_unresolved_broker_cells",
    "patch_workbook_cells_directly",
    "generic_statement_replacement",
    "weaken_schemas_validators_hashes_or_tolerances",
    "regenerate_expected_outputs_to_hide_failures",
    "claim_simulated_semantics_as_installed_host_black_box",
    "blind_revert_to_sunday"
  ]
}
