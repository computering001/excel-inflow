{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-intake-run-v1.schema.json",
  "title": "Visible Brokers milestone state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "status", "blocker_class", "user_blocking",
    "intake_state", "processing_state", "authority_state", "choice_receipt_path",
    "screen_path", "summary"
  ],
  "properties": {
    "schema_version": { "const": "broker-intake-run/1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "status": { "enum": ["ACTION_REQUIRED", "COMPLETE"] },
    "blocker_class": { "enum": ["USER_DECISION", null] },
    "user_blocking": { "type": "boolean" },
    "intake_state": { "enum": ["awaiting_choice", "supplied", "explicitly_skipped"] },
    "processing_state": { "enum": ["not_started"] },
    "authority_state": { "enum": ["not_resolved", "zero"] },
    "choice_receipt_path": { "type": ["string", "null"] },
    "screen_path": { "type": "string", "minLength": 1 },
    "summary": { "type": "object" }
  }
}
