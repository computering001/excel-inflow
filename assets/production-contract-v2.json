{
  "schema_version": 1,
  "contract_id": "excel-inflow-production-v2",
  "tolerances": {
    "description": "ONE ABSOLUTE TOLERANCE CANNOT SERVE MONEY AND MULTIPLES. validate_dynamic_model.mjs used a single 0.05 for every numeric comparison it made, and applied it to net leverage by plain absolute difference — 0.05 is 1.7% of a 3.0x headline metric, and that was recorded as agreement. It was equally wrong at the other end: 0.05 on a 26,971m gross-debt figure is 1.9e-6 relative, so a currency comparison that should have been exact was allowed two parts per million of drift. Tolerances are keyed by METRIC CLASS, and the currency floor is stated in reporting-currency units and scaled by issuer.units, so a model in millions and a model in units are held to the same economic precision rather than the same printed digits.",
    "unit_scale": {
      "units": 1,
      "thousands": 0.001,
      "millions": 0.000001
    },
    "metric_classes": {
      "currency": {
        "relative": 0.000001,
        "absolute_floor_currency_units": 1,
        "note": "A money figure is tested relatively, because the precision that matters scales with the figure. The floor is one currency unit — one euro, one dollar — expressed in the issuer's units through unit_scale, so it is what governs comparisons at or near zero."
      },
      "ratio": {
        "absolute": 0.0001,
        "note": "Leverage and coverage multiples. A multiple has no natural scale to be relative to and is read to two decimals, so it is tested absolutely, two orders of magnitude tighter than the printed precision."
      },
      "rate": {
        "absolute": 0.000001,
        "note": "Rates, margins, growth and conversion percentages: fractions of one, printed to a tenth of a point."
      }
    },
    "checks": {
      "statement-arithmetic": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate"
      },
      "standalone-adjustment-pro-forma-tie": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate",
        "note": "The pro-forma tie is A + B = C across three independently emitted columns. It gets its own entry because it is the one comparison whose two sides are computed by different formulas rather than being two readings of the same arithmetic."
      },
      "cross-row-equality": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate",
        "note": "Two cells that must state the same number — the income statement's interest expense against the interest schedule's gross interest, the cash flow's ending cash against the sweep, the pro-forma actual column against the latest standalone actual. Same number, so the only tolerance is arithmetic noise."
      },
      "independent-solver-parity": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate",
        "note": "net_leverage is a RATIO here and is why this block exists."
      },
      "input-authority": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate"
      },
      "liquidity-certification": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate"
      },
      "cfs-waterfall-component-parity": {
        "currency": "currency",
        "ratio": "ratio",
        "rate": "rate",
        "note": "The consolidated Change-in-Debt line against the waterfall rows that carry its constituents into ending cash: pre-RCF debt movement + RCF draw - RCF repayment. Both sides are money and both are computed by different formulas off the same debt schedule, so the only tolerance is arithmetic noise. Declared explicitly rather than left to the resolver's fall-through, so the band this comparison runs under is stated rather than inferred."
      }
    },
    "cli_override": {
      "allowed": true,
      "must_be_recorded_in_evidence": true,
      "note": "--tolerance still exists for diagnosis, but supplying it is recorded on the face of the validation report as tolerance_override so a report produced under a loosened tolerance can never be mistaken for one produced under the contract's."
    }
  },
