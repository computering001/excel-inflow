{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/pre-broker-model-demand-v2.schema.json",
  "title": "Model-owned demand compiled after filing topology and before optional broker recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "as_of", "reporting_currency", "units",
    "forecast_periods", "ontology_sha256", "nodes", "counts", "graph_sha256"
  ],
  "properties": {
    "schema_version": { "const": "pre-broker-model-demand/2.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "reporting_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "units": { "enum": ["units", "thousands", "millions", "billions"] },
    "forecast_periods": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "format": "date" }
    },
    "ontology_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id", "node_kind", "section", "source_line_id", "metric_id",
          "label", "parent_label", "period_end", "material", "source_backed",
          "broker_demand_eligible", "house_requirement", "allowed_authorities",
          "definition_signature_sha256", "consumer_ids"
        ],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "node_kind": { "enum": ["filed_observation", "model_demand"] },
          "section": { "enum": ["income_statement", "cash_flow"] },
          "source_line_id": { "type": ["string", "null"] },
          "metric_id": { "type": ["string", "null"] },
          "label": { "type": "string", "minLength": 1 },
          "parent_label": { "type": ["string", "null"] },
          "period_end": { "type": "string", "format": "date" },
          "material": { "type": "boolean" },
          "source_backed": { "type": "boolean" },
          "broker_demand_eligible": { "type": "boolean" },
          "house_requirement": { "enum": ["filed_only", "required", "headline_anchor", "optional"] },
          "allowed_authorities": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "definition_signature_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "consumer_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_rows", "filed_forecast_nodes", "model_demand_concepts", "model_demand_nodes", "material_model_demand_nodes"],
      "properties": {
        "source_rows": { "type": "integer", "minimum": 0 },
        "filed_forecast_nodes": { "type": "integer", "minimum": 0 },
        "model_demand_concepts": { "type": "integer", "minimum": 0 },
        "model_demand_nodes": { "type": "integer", "minimum": 0 },
        "material_model_demand_nodes": { "type": "integer", "minimum": 0 }
      }
    },
    "graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
