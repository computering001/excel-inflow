{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-source-tables.schema.json",
  "title": "Structured full-table broker evidence for workbook rendering",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "houses"],
  "properties": {
    "schema_version": { "const": "broker-source-tables/1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "houses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["house_id", "house_name", "source_id", "content_sha256", "tables"],
        "properties": {
          "house_id": { "type": "string", "minLength": 1 },
          "house_name": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "published_date": { "type": "string", "format": "date" },
          "file_name": { "type": "string", "minLength": 1 },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["table_id", "title", "source_location", "units", "extraction_method", "rows"],
              "properties": {
                "table_id": { "type": "string", "minLength": 1 },
                "title": { "type": ["string", "null"] },
                "source_location": { "type": "string", "minLength": 1 },
                "units": { "type": ["string", "null"] },
                "extraction_method": { "type": "string", "minLength": 1 },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": ["string", "number", "boolean", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
