{
  "schema_version": "real-filing-corpus-plan/1.0",
  "plan_id": "seeded-real-filing-corpus-2026-08",
  "purpose": "Declarative seed for the real-filing corpus: which issuers, which forms, which years, and the design-matrix tags every fetched candidate inherits. Raw filing bytes live in a LOCAL CUSTODY directory that is gitignored and never committed; only hashes and locators leave custody. The brief said 35 companies but enumerated 37; all 37 enumerated issuers are seeded.",
  "custody": {
    "default_dir": "corpus-custody",
    "committed_to_repository": false,
    "gitignored": true,
    "rule": "Primary documents, iXBRL instances, companyfacts payloads, candidate inventories and manifests are written here and never enter the index."
  },
  "fetch": {
    "rate_limit_requests_per_second": 8,
    "token_bucket_capacity": 8,
    "sec_hard_limit_note": "SEC fair-access limit is 10 req/s across sec.gov + data.sec.gov + efts.sec.gov combined; one shared token bucket covers all hosts.",
    "user_agent_env_var": "EDGAR_USER_AGENT",
    "user_agent_format": "Descriptive per SEC policy, e.g. 'Archie Preston archie@example.com' - name plus contact email. Refuses to run live without it.",
    "cik_resolution": "https://www.sec.gov/files/company_tickers.json pattern; a plan cik is only a hint and is verified against the ticker file at fetch time.",
    "submissions": "https://data.sec.gov/submissions/CIK##########.json filtered by form and report year; older filings pulled from the paginated submissions index files when needed."
  },
  "matrix_tags_vocabulary": {
    "regime": ["us_gaap", "ifrs", "uk_domestic"],
    "sector": ["industrials", "resources", "utilities", "financials", "healthcare", "tech", "consumer-staples", "telecom", "real-estate"],
    "size_band": ["mega", "large", "mid"],
    "debt_complexity": ["standard", "moderate", "complex"],
    "fy_end": "MM-DD of the issuer's typical fiscal close",
    "currency": "ISO 4217 reporting currency"
  },
  "license_basis_vocabulary": ["official_public_regulator", "issuer_ir_site", "third_party_local_custody_only"],
