{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "excel-inflow-mutation-adequacy/1.0",
  "title": "Mutation adequacy report and survivor register",
  "description": "P7.5. Mutation adequacy is MEASURED, not asserted. The registry declares test_class \"mutation\" suites; before this contract there was no score, no survivor register and no gate, so a suite that quietly stopped mutating anything still printed PASS. This schema binds four things that must travel together: (1) a score whose denominator is only what was actually measured — a suite reporting no mutation count is a GAP with an owner, never a zero; (2) a scope split so a mutation applied to a suite's OWN fixtures can never be counted as production coverage; (3) a survivor register where every mutation that did not die carries an owner and a pointer, under P7.3's disposition discipline (a registered survivor that stops reproducing must be RETIRED, never left standing); (4) a zero-survivor gate over the P0 invariant set that FAILS when a P0 mutation survives. The artifact is GENERATED by scripts/compile_mutation_adequacy.mjs and must never be hand-written.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile",
    "invariant",
    "score_doctrine",
    "survivor_doctrine",
    "corpus",
    "score",
    "p0_invariant_set",
    "zero_survivor_gate",
    "survivors",
    "retired_survivors",
    "measurement_gaps",
    "suites",
    "generator",
    "never_hand_written"
  ],
  "properties": {
    "schema_version": { "const": "excel-inflow-mutation-adequacy/1.0" },
    "profile": { "type": "string", "minLength": 1, "description": "Execution profile the measurement was taken under. Custody-bound suites are BLOCKED, never silently passed, in the portable profile." },
    "invariant": { "type": "string", "minLength": 1 },
    "score_doctrine": { "type": "string", "minLength": 1 },
    "survivor_doctrine": { "type": "string", "minLength": 1 },
    "generator": { "const": "scripts/compile_mutation_adequacy.mjs" },
    "never_hand_written": { "type": "string", "minLength": 1 },

    "corpus": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "registry_mutation_suites",
        "suites_reporting_a_mutation_count",
        "measurement_coverage",
        "measurement_coverage_meaning",
        "observed_field_name_inventory"
      ],
      "properties": {
        "registry_mutation_suites": { "type": "integer", "minimum": 1 },
        "suites_reporting_a_mutation_count": { "type": "integer", "minimum": 0 },
        "measurement_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "suites_reporting_a_mutation_count / registry_mutation_suites. The honest headline alongside the score: a high score over a small measured fraction is not adequacy."
        },
        "measurement_coverage_meaning": { "type": "string", "minLength": 1 },
        "observed_field_name_inventory": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "The inventoried field names suites actually use to report their mutation counts. Suites were written independently and each invented its own name; extraction is pattern-driven so a new name is still counted."
        }
      }
    },

    "score": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mutation_score",
        "measured_mutations",
        "killed",
        "survived",
        "suite_health",
        "production_mutation_score",
        "production_mutation_score_qualifier",
        "breakdown"
      ],
      "properties": {
        "mutation_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Survivor-honest aggregate: killed / (killed + survived) over PRODUCT mutants only (production + oracle-matrix scopes, never self-fixture), excluding crashed suites' pseudo-survivors. null when nothing was measured — never 0, which would assert a total-escape result that was not observed."
        },
        "mutation_score_basis": { "type": "string", "minLength": 1 },
        "measured_mutations": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "suite_health": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of mutation-class or gate-adjunct suites that CRASHED during this compilation. Crashes are health debt reported here; they are excluded from mutation_score."
        },
        "suite_health_meaning": { "type": "string", "minLength": 1 },
        "production_mutation_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "production_mutation_score_qualifier": {
          "type": "string",
          "pattern": "UPPER_BOUND",
          "description": "Must declare itself an upper bound. Static production reach proves a mutation COULD touch production code, not that it did."
        },
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["production_module_or_artifact", "self_fixture_only", "mixed_per_domain"],
          "properties": {
            "production_module_or_artifact": { "$ref": "#/definitions/bucket" },
            "self_fixture_only": { "$ref": "#/definitions/bucket" },
            "mixed_per_domain": { "$ref": "#/definitions/bucket" }
          }
        }
      }
    },

    "oracle_matrix_split": {
      "type": ["object", "null"],
      "description": "The oracle matrix suite is MIXED: ten artifact-scope domains driven from production output, five hand-written synthetic domains P7.6a marked NOT_INDEPENDENTLY_PROVEN. Its mutations are split by the matrix asset's own per-domain flags rather than credited whole."
    },

    "p0_invariant_set": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "explicit_p0_set_exists", "invariants", "derivation", "gate_members_parsed", "gate_members_derived"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "explicit_p0_set_exists": { "type": "boolean" },
        "derivation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "The gate composition must be DECLARED, never implicit: what was parsed from the programme, what was derived from the oracle matrix, and what was excluded by declaration."
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["package_id", "invariant", "declared_focused_test_ids", "mutation_class_provers"],
            "properties": {
              "package_id": { "type": "string", "pattern": "^P0\\.[0-9]+$" },
              "invariant": { "type": "string", "minLength": 1 },
              "declared_focused_test_ids": { "type": "array", "items": { "type": "string" } },
              "mutation_class_provers": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "p0_invariants_without_mutation_prover": {
          "type": "array",
          "items": { "type": "object" },
          "description": "P0 invariants no mutation-class suite proves. Enumerated as holes, never dropped."
        },
        "gate_members_parsed": { "type": "array", "items": { "type": "string" } },
        "gate_members_derived": { "type": "array", "items": { "type": "string" } }
      }
    },

    "zero_survivor_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["invariant", "profile", "members", "member_ids", "member_count", "survivors", "unproven_members", "status", "failure_rule"],
      "properties": {
        "invariant": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "member_count": { "type": "integer", "minimum": 1, "description": "A gate with zero members is a decorative gate and is rejected." },
        "member_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["test_id", "corpus_membership", "measurement", "killed", "survived", "source"],
            "properties": {
              "test_id": { "type": "string", "minLength": 1 },
              "corpus_membership": { "enum": ["registry_mutation_class", "p0_gate_adjunct"] },
              "measurement": { "type": "string", "minLength": 1 },
              "killed": { "type": "integer", "minimum": 0 },
              "survived": { "type": "integer", "minimum": 0 },
              "source": { "enum": ["parsed_from_p0_issue_card", "derived_from_oracle_matrix_artifact_scope"] }
            }
          }
        },
        "survivors": { "type": "array", "items": { "type": "string" } },
        "unproven_members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id", "reason"],
            "properties": { "test_id": { "type": "string" }, "reason": { "type": "string" } }
          },
          "description": "A gate member that could not be measured in this profile. UNPROVEN is reported, never converted to PASS."
        },
        "status": { "enum": ["PASS", "PASS_WITH_UNPROVEN_MEMBERS", "FAIL"] },
        "failure_rule": { "type": "string", "minLength": 1 }
      }
    },

    "survivors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["survivor_id", "test_id", "owner", "pointer", "survived_mutations", "count_basis", "suite_failed", "disposition"],
        "properties": {
          "survivor_id": { "type": "string", "minLength": 1 },
          "test_id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1, "pattern": "^(?!UNOWNED$).+$" },
          "pointer": { "type": "string", "minLength": 1 },
          "survived_mutations": { "type": "integer", "minimum": 1 },
          "count_basis": { "enum": ["suite_reported_population", "UNKNOWN_POPULATION_FLOORED_AT_1"] },
          "reproduced_serially": { "type": "boolean", "description": "A survivor claim must reproduce when the suite is run alone; a pool-only failure is a measurement gap, not a survivor." },
          "suite_failed": {
            "type": "boolean",
            "description": "True when the SUITE itself crashed: its floored pseudo-survivors are custody debt counted once in score.suite_health, never escaped-product evidence. False when a completing suite registered an escaped product mutant."
          },
          "disposition": { "const": "OPEN" }
        }
      }
    },

    "retired_survivors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["survivor_id", "repaired_layer", "repaired_by", "retired_by"],
        "properties": {
          "survivor_id": { "type": "string", "minLength": 1 },
          "repaired_layer": { "type": "string", "minLength": 1 },
          "repaired_by": { "type": "string", "minLength": 1 },
          "retired_by": { "type": "string", "minLength": 1 }
        }
      },
      "description": "Survivors retired because the HOLE WAS CLOSED, never because the entry was inconvenient. Nothing reads this list as a control input: a retired survivor that reappears is registered again as a new OPEN survivor and fails the suite exactly as before."
    },

    "measurement_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["test_id", "owner", "gap", "pointer", "remedy"],
        "properties": {
          "test_id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1, "pattern": "^(?!UNOWNED$).+$" },
          "gap": { "type": "string", "minLength": 1 },
          "pointer": { "type": "string", "minLength": 1 },
          "remedy": { "type": "string", "minLength": 1 }
        }
      },
      "description": "Every mutation-class suite whose mutation population cannot be measured from outside itself, with an owner. This list is the real deliverable next to the score: it is why measurement_coverage is not 1."
    },

    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/suite" }
    },
    "p0_gate_adjunct_suites": {
      "type": "array",
      "items": { "$ref": "#/definitions/suite" }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commit", "worktree_dirty", "survivor_attribution_caveat"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "worktree_dirty": { "type": ["boolean", "null"] },
        "modified_tracked_files": { "type": "array", "items": { "type": "string" } },
        "survivor_attribution_caveat": { "type": "string", "minLength": 1 }
      }
    }
  },

  "definitions": {
    "bucket": {
      "type": "object",
      "additionalProperties": true,
      "required": ["suites", "suites_reporting_a_count", "measured_mutations", "killed", "survived", "score"],
      "properties": {
        "suites": { "type": "integer", "minimum": 0 },
        "suites_reporting_a_count": { "type": "integer", "minimum": 0 },
        "measured_mutations": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "test_id",
        "corpus_membership",
        "declared_test_class",
        "owner",
        "script",
        "status",
        "mutation_scope",
        "reports_mutation_count",
        "declared_mutations",
        "killed",
        "survived",
        "measurement"
      ],
      "properties": {
        "test_id": { "type": "string", "minLength": 1 },
        "corpus_membership": { "enum": ["registry_mutation_class", "p0_gate_adjunct"] },
        "declared_test_class": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "mutation_scope": {
          "enum": ["production_module_under_mutation", "production_artifact_under_mutation", "self_fixture_only", "mixed_per_domain"],
          "description": "self_fixture_only mutations are counted in their own bucket and can NEVER raise production_mutation_score."
        },
        "reports_mutation_count": { "type": "boolean" },
        "declared_mutations": { "type": ["integer", "null"], "minimum": 0 },
        "mutation_families": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Fields grouped by family with the family's population taken as the MAX of its members, never their sum, so a suite printing both `mutations` and `mutations_rejected` for one population is not double-counted."
        },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "measurement": {
          "enum": [
            "MEASURED",
            "SURVIVOR",
            "UNREPORTED_POPULATION",
            "BLOCKED_ON_CUSTODY",
            "UNMEASURABLE",
            "FLAKY_UNDER_CONCURRENCY",
            "NOT_EXECUTED",
            "UNKNOWN"
          ]
        }
      },
      "allOf": [
        {
          "description": "A suite that reports no mutation count must carry no invented population.",
          "if": { "properties": { "reports_mutation_count": { "const": false } }, "required": ["reports_mutation_count"] },
          "then": {
            "properties": {
              "declared_mutations": { "const": null },
              "killed": { "const": 0 }
            }
          }
        },
        {
          "description": "MEASURED requires a self-reported population; a measurement cannot be conjured from a bare PASS.",
          "if": { "properties": { "measurement": { "const": "MEASURED" } }, "required": ["measurement"] },
          "then": { "properties": { "reports_mutation_count": { "const": true } } }
        }
      ]
    }
  }
}
