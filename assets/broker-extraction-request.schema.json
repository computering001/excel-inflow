{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/excel-inflow/broker-extraction-request.schema.json",
  "title": "Excel Inflow broker-document extraction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "documents"],
  "properties": {
    "schema_version": { "const": "broker-extraction-request/1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "model_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "reporting_currency", "units", "forecast_periods"],
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "reporting_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "units": { "enum": ["units", "thousands", "millions", "billions"] },
        "forecast_periods": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "format": "date" }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "house_id",
          "house_name",
          "source_id",
          "path",
          "media_type",
          "published_date"
        ],
        "properties": {
          "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
          "house_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
          "house_name": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "media_type": {
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/vnd.ms-excel.sheet.macroEnabled.12",
              "text/csv",
              "text/plain",
              "text/markdown",
              "text/html",
              "application/json",
              "image/png",
              "image/jpeg"
            ]
          },
          "published_date": { "type": "string", "format": "date" },
          "password": { "type": ["string", "null"] },
          "expected_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
