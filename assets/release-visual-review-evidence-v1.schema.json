{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-visual-review-evidence/1.0",
  "title": "Excel Inflow native visual-review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "reviewer",
    "method",
    "total_violations",
    "certified_closure_sha256",
    "reviewed_profiles",
    "workbooks",
    "screenshot_evidence",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "release-visual-review-evidence/1.0" },
    "status": { "const": "PASS" },
    "generated_at": { "type": "string", "format": "date-time" },
    "reviewer": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "total_violations": { "const": 0 },
    "certified_closure_sha256": { "$ref": "#/$defs/sha256" },
    "reviewed_profiles": {
      "type": "array",
      "prefixItems": [
        { "const": "standard_maximal" },
        { "const": "standard_net_cash" },
        { "const": "acquisition" },
        { "const": "stressed_liquidity" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "workbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/workbook" },
      "minItems": 4,
      "maxItems": 4
    },
    "screenshot_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/screenshot" },
      "minItems": 12,
      "maxItems": 12
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbook_openability",
        "sheet_completeness",
        "layout_geometry",
        "formatting_consistency",
        "formula_visibility",
        "provenance_colours",
        "print_and_panes",
        "screenshot_legibility"
      ],
      "properties": {
        "workbook_openability": { "const": "PASS" },
        "sheet_completeness": { "const": "PASS" },
        "layout_geometry": { "const": "PASS" },
        "formatting_consistency": { "const": "PASS" },
        "formula_visibility": { "const": "PASS" },
        "provenance_colours": { "const": "PASS" },
        "print_and_panes": { "const": "PASS" },
        "screenshot_legibility": { "const": "PASS" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "enum": [
        "standard_maximal",
        "standard_net_cash",
        "acquisition",
        "stressed_liquidity"
      ]
    },
    "sheetNames": {
      "type": "array",
      "prefixItems": [
        { "const": "Operating Model" },
        { "const": "Brokers" },
        { "const": "Forward Curves" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "path", "sha256", "sheet_names"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sheet_names": { "$ref": "#/$defs/sheetNames" }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "sheet", "path", "sha256"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "sheet": {
          "enum": ["Operating Model", "Brokers", "Forward Curves"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
