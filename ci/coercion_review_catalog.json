  "schema_version": "excel-inflow-coercion-review-catalog/1.0",
  "reviewed_by": "mp2-D3-coercion-review",
  "review_basis": "Every scanned expression was read in its owning file. Per-file entry counts and sorted-fingerprint digests bind this review to the exact source expressions; changed or added expressions do not inherit review.",
  "scope_legend": {
    "broker_coordinates": "Broker/filing extraction coordinates, cell counts, and source-layout identifiers are non-financial control metadata; any financial payload expression remains classified suspect.",
    "model_emission": "Workbook construction and formula-cache expressions were reviewed at their emission/evaluation sites; financial fallbacks remain suspect while geometry, counters, and presentation-only detection remain lawful.",
    "source_ingress": "Attachment/source ingestion was reviewed at the trust boundary; financial projected values remain suspect while byte counts, indices, and bounded resource metadata are lawful.",
    "economic_runtime": "Solver, policy, roll-forward, reconciliation, and validation expressions were reviewed as live economic paths; nullable financial operands remain suspect unless the expression is control metadata.",
    "typed_authority": "Typed-value, authority, constitution, and semantic-graph expressions were reviewed for state propagation; financial/value fallbacks remain suspect and state/census counters are lawful.",
    "forecast_control": "Forecast selection, ownership, completion, and candidate expressions were reviewed; scores/counts are non-financial control metadata and value-bearing operands remain suspect.",
    "ux_display": "Flow/review/screen expressions were reviewed at the user-facing boundary; display counters are lawful and values used to decide or describe economics remain suspect.",
    "runtime_governance": "Runtime, release, resource, deadline, heartbeat, and CI expressions are durations, counts, identifiers, or policy-control metadata and cannot enter workbook economics.",
    "oracle_mixed": "Independent oracle and mutation code was reviewed separately from production; workbook values remain suspect while XML/style/index/pixel/test-control quantities are lawful.",
    "schema_geometry": "Schema, topology, row-plan, and workbook-semantic expressions were reviewed; indices/geometry are lawful while row values and dates that can affect model semantics remain suspect.",
    "case_fixture": "Case compiler/generator and test-fixture expressions were reviewed; fixture coverage controls are lawful and generated economic values remain suspect.",
    "security_custody": "Custody, staging, intake, security, and attestation expressions are lengths/counts/control flags and do not supply workbook financial values."
  },
